{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/common"
    }
  ],
  "rewrites": [
    {
      "source": "/cors-proxy/:path*",
      "destination": "https://site-ethmarks.vercel.app/:path*"
    }
  ]
}
